{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "OpenMct Configuration Schema",
    "description": "Schema for OpenMCT configuration YAML",
    "definitions": {
        "pluginMap": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                  "$ref": "#/definitions/plugin"
                }
            }
        },
        "plugin": {
            "type": "object",
            "properties": {
                "source": {
                    "type": "string",
                    "enum": ["npm", "github", "local", "builtin"],
                    "default": "builtin"
                },
                "npmPackage": {
                    "type": "string",
                    "description": "NPM package that provides this plugin."
                },
                "entryPoint": {
                    "type": "string",
                    "description": "Script that exports the install function"
                },
                "version": {
                    "type": "string",
                    "description": "Version of the plugin to use"
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Whether the plugin should be enabled. By setting this to false you can override default plugins"
                },
                "options": {
                    "type": "object",
                    "description": "The options to be passed to the plugin at install time"
                }
            },
            "additionalProperties": true
        }
    },
    "type": "object",
    "required": ["openmct"],
    "properties": {
      "openmct": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "description": "Version of OpenMCT to use",
            "default": "latest"
          },
          "plugins": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Plugin identifier (e.g., 'openmct.Plugins.LocalStorage')"
                },{
                    "$ref": "#/definitions/pluginMap" 
                }
              ]
            }
          }
        }
      }
    }
  }