{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenMCT Plugins Index",
  "description": "Schema for the OpenMCT external plugins index",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },
    "plugins": {
      "type": "array",
      "description": "Array of available plugins",
      "items": {
        "type": "object",
        "properties": {
          "npmPackageName": {
            "type": "string",
            "description": "The npm package name or specifier for the plugin (e.g., 'akhenry/openmct-yamcs' or 'openmct-plugin@1.0.0')"
          }
        },
        "required": ["npmPackageName"],
        "additionalProperties": false
      }
    }
  },
  "required": ["plugins"],
  "additionalProperties": false
}