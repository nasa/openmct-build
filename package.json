    "@types/lodash.merge": "^4.6.9",
    "@types/node": "22.9.0",
    "c8": "^12.0.0",
    "http-server": "^14.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "openmct": "^4.3.0-rc1",
    "test-plugin": "^0.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@npm/types": "^2.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "app-root-path": "^3.1.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "jsonschema": "^1.5.0",
    "lodash.merge": "^4.6.2",
    "tsx": "^4.7.1"
  }
