{
  "name": "openmct-build",
  "version": "0.0.1",
  "description": "",
  "main": "scripts/mct.ts",
  "bin": {
    "mct": "scripts/mct.ts"
  },
  "scripts": {
    "test": "playwright test",
    "test:watch": "playwright test --ui",
    "test:coverage": "c8 --all --src src --include 'src/**' --exclude '**/*.spec.ts' --exclude 'src/assets/**' --exclude 'src/openmct/OpenMctConfigurationDocument.ts' --reporter=text --reporter=lcov playwright test",
    "generate:types": "npx tsx scripts/generate-types.ts"
  },
